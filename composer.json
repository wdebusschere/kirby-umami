{
    "name": "akibeo/kirby-umami",
    "description": "Umami analytics for Kirby CMS: tracker script with CSP nonce, server-side events and a Panel stats view.",
    "type": "kirby-plugin",
    "license": "MIT",
    "keywords": ["kirby", "kirby-plugin", "umami", "analytics", "privacy", "cookieless", "panel"],
    "homepage": "https://github.com/wdebusschere/kirby-umami",
    "authors": [
        {
            "name": "Wannes Debusschere",
            "email": "wannes@e-xperience.pt",
            "homepage": "https://e-xperience.pt"
        }
    ],
    "support": {
        "issues": "https://github.com/wdebusschere/kirby-umami/issues",
        "source": "https://github.com/wdebusschere/kirby-umami"
    },
    "require": {
        "php": ">=8.1",
        "getkirby/composer-installer": "^1.2"
    },
    "require-dev": {
        "getkirby/cms": "^4.0 || ^5.0",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Akibeo\\Umami\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Akibeo\\Umami\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "getkirby/composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
